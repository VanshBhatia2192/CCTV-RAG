#!/bin/bash
#PBS -N cctv_job
#PBS -q gpu
#PBS -l select=1:ncpus=8:mem=96gb:ngpus=1
#PBS -l walltime=05:00:00
#PBS -j oe
#PBS -V
cd $PBS_O_WORKDIR
mkdir -p outputs/logs
exec > outputs/logs/job_${PBS_JOBID%%.*}.log 2>&1
source /home/soft/anaconda3/etc/profile.d/conda.sh
conda activate cctv
module load cuda
export LD_PRELOAD=$CONDA_PREFIX/lib/libstdc++.so.6
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True PYTHONUNBUFFERED=1
export HF_HOME=$PWD/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 YOLO_OFFLINE=1 QDRANT__TELEMETRY_DISABLED=true
export QDRANT_URL=http://localhost:6333 NO_PROXY=localhost,127.0.0.1
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
nvidia-smi --query-gpu=index,memory.used,memory.free --format=csv
if [ -z "$CUDA_VISIBLE_DEVICES" ]; then
  read G F <<< $(nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits | tr -d ' ' | awk -F, '{print $1, $2}' | sort -k2 -nr | head -1)
  echo "using GPU $G (free ${F} MiB)"
  [ "$F" -lt 9000 ] && { echo "not enough free GPU memory on any GPU"; exit 1; }
  export CUDA_VISIBLE_DEVICES=$G
else
  echo "PBS assigned CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
fi
python -c "import torch; f,t=torch.cuda.mem_get_info(); print('cuda', torch.cuda.is_available(), f'free {f/1e9:.1f} GB of {t/1e9:.1f}')"
(cd data/indexes/qdrant && nohup ../../../bin/qdrant > ../../../outputs/logs/qdrant_job.log 2>&1 &)
for i in $(seq 30); do python -c "import urllib.request; urllib.request.urlopen('$QDRANT_URL')" >/dev/null 2>&1 && break; sleep 2; done
python -c "import urllib.request; urllib.request.urlopen('$QDRANT_URL')" >/dev/null 2>&1 || { echo "Qdrant failed"; tail -n 20 outputs/logs/qdrant_job.log; exit 1; }
echo "running: $J"; bash $J; RC=$?
echo "job finished, exit code $RC"
pkill -f bin/qdrant || true
exit $RC
