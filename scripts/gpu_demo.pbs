#!/bin/bash
#PBS -N cctv_demo
#PBS -q gpu
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V
cd $PBS_O_WORKDIR
source /home/soft/anaconda3/etc/profile.d/conda.sh
conda activate cctv
module load cuda
export LD_PRELOAD=$CONDA_PREFIX/lib/libstdc++.so.6
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True PYTHONUNBUFFERED=1
export HF_HOME=$PWD/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 YOLO_OFFLINE=1
export QDRANT__TELEMETRY_DISABLED=true
export QDRANT_URL=http://localhost:6333 GRADIO_SERVER_NAME=0.0.0.0
(cd data/indexes/qdrant && nohup ../../../bin/qdrant > ../../../outputs/logs/qdrant_demo.log 2>&1 &)
sleep 8
echo "UI running on $(hostname):7860"
python -m src.ui.app
