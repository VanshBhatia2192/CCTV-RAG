#!/bin/bash
# Run the web demo on a GPU node, so the LLM query planner and VLM verification are fast.
#   bash scripts/hpc/submit.sh scripts/hpc/demo_gpu.pbs   (PBS picks a node; SR_HOST=gpu01 pins one)
#   bash scripts/hpc/demo_url.sh                           prints the tunnel command once it is up
#   then open http://localhost:8000 on your laptop; stop with qdel <jobid>
# On the node the job takes the least busy GPU with at least NEED_MB free (default 24000) and the first
# free port from 8000 up.
# Uses the Qdrant server on mgmt01 (scripts/run_demo.sh starts it, port 6335), or a node-local copy if unreachable.
#PBS -N cctv_demo_gpu
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -k oed
cd "$PBS_O_WORKDIR"
mkdir -p outputs/logs
exec >> outputs/logs/demo_gpu.log 2>&1
echo "== job $PBS_JOBID on $(hostname) at $(date)"
source /home/soft/anaconda3/etc/profile.d/conda.sh && conda activate cctv
export LD_PRELOAD=$CONDA_PREFIX/lib/libstdc++.so.6 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=8
export HF_HOME=$PWD/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
export NO_PROXY=localhost,127.0.0.1,mgmt01,10.17.1.5 no_proxy=localhost,127.0.0.1,mgmt01,10.17.1.5
# nodes are shared and jobs see every GPU: claim the freest one with an atomic per-GPU lock (same as captions_v2.pbs)
CUDA_VISIBLE_DEVICES=""
# among GPUs with enough free memory prefer the least busy one (other users' jobs share these GPUs), then the emptiest
for g in $(nvidia-smi --query-gpu=index,memory.free,utilization.gpu --format=csv,noheader,nounits | awk -F', ' -v need=${NEED_MB:-24000} '$2 > need' | sort -t, -k3,3n -k2,2nr | cut -d, -f1); do
  if mkdir "/tmp/gpu_claim_${g}" 2>/dev/null; then CUDA_VISIBLE_DEVICES=$g; trap 'rmdir /tmp/gpu_claim_'$g EXIT; break; fi
done
[ -n "$CUDA_VISIBLE_DEVICES" ] || { echo "no GPU with ${NEED_MB:-24000} MB free on $(hostname); resubmit or set SR_HOST to the other node"; exit 1; }
export CUDA_VISIBLE_DEVICES
nvidia-smi --query-gpu=index,name,memory.free,utilization.gpu --format=csv,noheader -i $CUDA_VISIBLE_DEVICES
PORT=${PORT:-8000}
while ss -ltn | grep -q ":$PORT "; do PORT=$((PORT + 1)); done
for u in http://mgmt01:6335 http://10.17.1.5:6335; do
  curl -s --max-time 4 "$u/collections" > /dev/null && { export QDRANT_URL=$u; break; }
done
if [ -z "${QDRANT_URL:-}" ]; then
  QD=/tmp/qdrant_${USER}_${PBS_JOBID}; mkdir -p $QD && cp -r data/indexes/qdrant/. $QD/
  (cd $QD && QDRANT__SERVICE__HTTP_PORT=6345 QDRANT__SERVICE__GRPC_PORT=6346 QDRANT__TELEMETRY_DISABLED=true \
     nohup $PBS_O_WORKDIR/bin/qdrant > $PBS_O_WORKDIR/outputs/logs/qdrant_demo_gpu.log 2>&1 &)
  export QDRANT_URL=http://localhost:6345
  for i in $(seq 1 30); do sleep 2; curl -s --max-time 2 $QDRANT_URL/collections > /dev/null && break; done
fi
export DEMO_DB=/tmp/meta_demo_${USER}_${PBS_JOBID}.db
python - <<'PY'
import os, sqlite3
src = sqlite3.connect("file:data/indexes/sqlite/meta.db?mode=ro&immutable=1", uri=True)
dst = sqlite3.connect(os.environ["DEMO_DB"]); src.backup(dst); dst.close()
PY
echo "qdrant: $QDRANT_URL"
echo "DEMO_AT $(hostname):$PORT gpu=$CUDA_VISIBLE_DEVICES job=$PBS_JOBID"
echo "on your laptop: ssh -N -L 8000:$(hostname):$PORT hpc   then open http://localhost:8000"
uvicorn app.main:app --host 0.0.0.0 --port $PORT
