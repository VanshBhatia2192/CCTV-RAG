#!/bin/bash
# Before/after comparison of context-aware search on one GPU: rules planner, LLM planner, and VLM verification.
# Uses the Qdrant server already running on mgmt01 (scripts/run_demo.sh, port 6335) and a node-local SQLite copy.
#   bash scripts/hpc/submit.sh scripts/hpc/search_compare.pbs
#   qsub -v RUNS="verify" scripts/hpc/search_compare.pbs      # subset of: rules llm verify
#PBS -N search_compare
#PBS -q gpu
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -k oed
cd "$PBS_O_WORKDIR"
mkdir -p outputs/logs
exec >> outputs/logs/search_compare.log 2>&1
echo "== job $PBS_JOBID on $(hostname) at $(date)"
source /home/soft/anaconda3/etc/profile.d/conda.sh && conda activate cctv
export LD_PRELOAD=$CONDA_PREFIX/lib/libstdc++.so.6 PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
export HF_HOME=$PWD/hf_cache HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
export NO_PROXY=localhost,127.0.0.1,mgmt01,10.17.1.5,10.16.1.50 no_proxy=localhost,127.0.0.1,mgmt01,10.17.1.5,10.16.1.50
# jobs see every GPU on the node: use the one with the most free memory
export CUDA_VISIBLE_DEVICES=$(nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits | sort -t, -k2 -nr | head -1 | cut -d, -f1)
nvidia-smi --query-gpu=index,name,memory.free --format=csv | sed -n "1p;$((CUDA_VISIBLE_DEVICES + 2))p"
# Qdrant: the demo's server on mgmt01 if this node can reach it, else a private server on a node-local copy
for u in ${QDRANT_URL:-} http://mgmt01:6335 http://10.17.1.5:6335 http://10.16.1.50:6335; do
  curl -s --max-time 4 "$u/collections" > /dev/null && { export QDRANT_URL=$u; break; }
done
if [ -z "${QDRANT_URL:-}" ] || ! curl -s --max-time 4 "$QDRANT_URL/collections" > /dev/null; then
  QD=/tmp/qdrant_${USER}_${PBS_JOBID}; mkdir -p $QD && cp -r data/indexes/qdrant/. $QD/
  (cd $QD && QDRANT__SERVICE__HTTP_PORT=6345 QDRANT__SERVICE__GRPC_PORT=6346 QDRANT__TELEMETRY_DISABLED=true \
     nohup $PBS_O_WORKDIR/bin/qdrant > $PBS_O_WORKDIR/outputs/logs/qdrant_search_compare.log 2>&1 &)
  export QDRANT_URL=http://localhost:6345
  for i in $(seq 1 30); do sleep 2; curl -s --max-time 2 $QDRANT_URL/collections > /dev/null && break; done
fi
curl -s --max-time 5 "$QDRANT_URL/collections" > /dev/null || { echo "Qdrant not reachable"; exit 1; }
echo "qdrant: $QDRANT_URL"
export DEMO_DB=/tmp/meta_search_${USER}_${PBS_JOBID}.db
python - <<'PY'
import os, sqlite3
src = sqlite3.connect("file:data/indexes/sqlite/meta.db?mode=ro&immutable=1", uri=True)
dst = sqlite3.connect(os.environ["DEMO_DB"]); src.backup(dst); dst.close()
print("node-local index copy:", os.environ["DEMO_DB"])
PY
for run in ${RUNS:-rules llm verify}; do
  echo "---- run: $run"
  case $run in
    rules)  python -m eval.search.compare_queries --show 3 ;;
    llm)    python -m eval.search.compare_queries --show 3 --llm ;;
    verify) python -m eval.search.compare_queries --show 5 --verify ;;
  esac
done
rm -f "$DEMO_DB"
if [ -n "${QD:-}" ]; then pkill -u "$USER" -f "^$PBS_O_WORKDIR/bin/qdrant" ; rm -rf "$QD"; fi
echo "== done $(date)"
